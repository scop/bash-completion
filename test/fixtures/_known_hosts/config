    UserKnownHostsFile _known_hosts/known_hosts

    # Unindented
Host *
     IPQoS none
Host gee* jar?this-part-we-do-not-complete-at-least-yet
     HostName %h.example.com
	# Indented, with = separator, and an unquoted # starting a comment
    Host = hus%%eth0 !negated  #comment
# Quoted, also within an argument, and a quoted # that is not a comment
Host "double_quoted" 'single_quoted' mid"dl"e "#not-a-comment"
# A pattern with a space matches no host name
Host "with space"
# An unterminated quote, which ssh rejects
Host "unterminated
